# ─── API Configuration ────────────────────────────────────────────────────────
#
# Option 1: OpenRouter (recommended — free models available, no credit card)
# Get your key at: https://openrouter.ai/keys
# Free models: append :free to any model slug
#
OPENROUTER_API_KEY=your_openrouter_api_key_here
#
# Model to use (free options — pick one):
#   qwen/qwen3-8b:free                              ← fast, good for structured JSON
#   meta-llama/llama-3.1-8b-instruct:free
#   mistralai/mistral-7b-instruct:free
#   nvidia/llama-3.1-nemotron-nano-8b-v1:free
#
LLM_MODEL=qwen/qwen3-8b:free
#
# Option 2: xAI Grok (if you have access)
# Get your key at: https://console.x.ai/
#
XAI_API_KEY=
#
# If neither key is set, the pipeline uses a regex-based fallback extractor
# over the manufacturer source text — no API call, still fully functional.
# ─────────────────────────────────────────────────────────────────────────────
