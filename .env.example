# xAI (Grok) API key — used by src/enrich.py for LLM extraction from
# retrieved manufacturer source text.
#
# If this is unset, enrich.py falls back to a small regex-based
# extractor over the curated source text instead of calling the real
# API — useful for local development/testing without a live key, but
# NOT a substitute for the real extraction call in the actual submission.
XAI_API_KEY=
